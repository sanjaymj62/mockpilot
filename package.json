{
  "name": "mockpilot-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"@mockpilot/web\" --filter \"@mockpilot/backend\" dev",
    "dev:web": "pnpm --filter \"@mockpilot/web\" dev",
    "dev:backend": "pnpm --filter \"@mockpilot/backend\" dev",
    "build": "pnpm --filter \"@mockpilot/core\" build && pnpm --filter \"@mockpilot/backend\" build && pnpm --filter \"@mockpilot/web\" build && pnpm --filter \"@mockpilot/cli\" build",
    "build:core": "pnpm --filter \"@mockpilot/core\" build",
    "build:backend": "pnpm --filter \"@mockpilot/backend\" build",
    "build:web": "pnpm --filter \"@mockpilot/web\" build",
    "build:cli": "pnpm --filter \"@mockpilot/cli\" build",
    "start:backend": "pnpm --filter \"@mockpilot/backend\" start",
    "start:web": "pnpm --filter \"@mockpilot/web\" start"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
