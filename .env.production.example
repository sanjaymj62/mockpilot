# Supabase Production (Cloud)
# Replace these with your actual Supabase project values from https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database
# Get this from https://app.supabase.com/project/_/settings/database
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Dodo Payments
DODO_API_KEY=your_dodo_api_key_here
DODO_WEBHOOK_SECRET=your_dodo_webhook_secret_here
NEXT_PUBLIC_DODO_PRODUCT_TEAM=prod_team_id_here
NEXT_PUBLIC_DODO_PRODUCT_PRO=prod_pro_id_here

# Frontend URL (for payment redirects)
FRONTEND_URL=https://yourdomain.com
